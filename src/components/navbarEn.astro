<!-- 1. BARRA SUPERIOR (Selector idioma + Botón hamburguesa) -->
<nav class="absolute top-0 right-0 p-8 sm:p-10 z-50 flex items-center gap-6 sm:gap-8">
  <div class="flex items-center gap-2 text-xs uppercase tracking-widest font-medium">
    <a href="/" class="text-slate-400 hover:text-brand-coral transition-colors">ES</a>
    <span class="text-slate-300">/</span>
    <span class="text-slate-950 font-bold border-b border-slate-950 pb-0.5">EN</span>
    
  </div>

  <button 
    id="menu-toggle-es" 
    class="w-10 h-8 flex items-center justify-end group shrink-0 z-50 focus:outline-none cursor-pointer" 
    aria-label="Abrir menú"
  >
    <svg class="w-10 h-6 text-slate-950 group-hover:text-brand-coral transition-colors duration-300" viewBox="0 0 40 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="12" y1="4" x2="38" y2="4" class="transition-all duration-300 group-hover:translate-x-1" />
      <line x1="2" y1="12" x2="38" y2="12" class="transition-all duration-300 group-hover:-translate-x-1" />
      <line x1="20" y1="20" x2="38" y2="20" class="transition-all duration-300 group-hover:translate-x-1" />
    </svg>
  </button>
</nav>

<!-- 2. MENÚ DESPLEGABLE OVERLAY -->
<div 
  id="menu-overlay-es" 
  class="fixed inset-0 bg-white/95 backdrop-blur-md z-40 flex flex-col justify-center items-center opacity-0 pointer-events-none transition-all duration-500 ease-[cubic-bezier(0.77,0,0.175,1)]"
>
  <ul class="text-center space-y-20 font-sans">
    <li class="menu-item-anim opacity-0 translate-y-6 transition-all duration-500 ease-out">
      <a href="/" class="block text-3xl md:text-5xl font-extralight text-slate-950 hover:text-brand-coral transition-colors">
        Home
      </a>
    </li>
    <li class="menu-item-anim opacity-0 translate-y-6 transition-all duration-500 ease-out">
      <a href="/en/portfolio" class="block text-3xl md:text-5xl font-extralight text-slate-950 hover:text-brand-coral transition-colors">
        Portfolio
      </a>
    </li>
    <li class="menu-item-anim opacity-0 translate-y-6 transition-all duration-500 ease-out">
      <a href="/en/about" class="block text-3xl md:text-5xl font-extralight text-slate-950 hover:text-brand-coral transition-colors">
        About
      </a>
    </li>
  </ul>
</div>

<script>
  function setupMenuES() {
    const toggleBtn = document.getElementById('menu-toggle-es');
    const overlay = document.getElementById('menu-overlay-es');
    const menuItems = document.querySelectorAll('#menu-overlay-es .menu-item-anim');

    if (!toggleBtn || !overlay) return;

    // Listener directo
    toggleBtn.onclick = () => {
      const isOpen = overlay.classList.contains('opacity-100');
      
      if (isOpen) {
        // Cierre
        overlay.classList.remove('opacity-100', 'pointer-events-auto');
        overlay.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';

        menuItems.forEach((item) => {
          item.classList.remove('opacity-100', 'translate-y-0');
          item.classList.add('opacity-0', 'translate-y-6');
          (item as HTMLElement).style.transitionDelay = '0ms';
        });
      } else {
        // Apertura
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.classList.add('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = 'hidden';

        menuItems.forEach((item, index) => {
          (item as HTMLElement).style.transitionDelay = `${150 + index * 100}ms`;
          item.classList.remove('opacity-0', 'translate-y-6');
          item.classList.add('opacity-100', 'translate-y-0');
        });
      }
    };
  }

  // Ejecución directa en carga e hidratación
  setupMenuES();
  document.addEventListener('astro:page-load', setupMenuES);
</script>