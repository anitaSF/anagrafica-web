			</div>
    </section>

    <!-- SECCIÓN FORMACIÓN, CONOCIMIENTOS Y APTITUDES -->
    <section class="max-w-[1500px] mx-auto px-6 font-sans space-y-20 mt-10 sm:mt-0">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-start">
        
        <!-- ================= COLUMNA IZQUIERDA (Formación + Aptitudes) ================= -->
        <div class="space-y-16">
          
          <!-- SUB-BLOQUE: Formación -->
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-start">
            <div class="sm:col-span-5 pb-4 sm:pb-0">
              <h3 class="text-3xl md:text-4xl font-extralight tracking-tight text-slate-950">
                Formación_
              </h3>
            </div>

            <div class="sm:col-span-7 space-y-5">
              <!-- Licenciatura BBAA -->
              <div class="border-b border-slate-100 pb-2.5">
