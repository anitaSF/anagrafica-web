                <div class="flex justify-between items-center text-xs text-slate-400 font-light mt-0.5">
                  <span>UPV</span>
                  <span>Oct 2010 – Jul 2012</span>
                </div>
              </div>

              <!-- Máster Diseño -->
              <div class="border-b border-slate-100 pb-2.5">
                <h4 class="text-base font-normal text-slate-950">Máster Diseño Publicitario</h4>
                <div class="flex justify-between items-center text-xs text-slate-400 font-light mt-0.5">
                  <span>TRAZOS</span>
                  <span>Oct 2013 – Jul 2014</span>
                </div>
              </div>

              <!-- Bootcamp -->
              <div class="border-b border-slate-100 pb-2.5">
