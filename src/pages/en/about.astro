                <div class="flex justify-between items-center text-xs text-slate-400 font-light mt-0.5">
                  <span>Upgrade Hub</span>
                  <span>Feb – Jul 2024</span>
                </div>
              </div>
            </div>
          </div>

          <!-- SUB-BLOQUE: Aptitudes profesionales -->
