---
import Navbar from '@/components/NavbarEn.astro';
const email = "anagrafica.grafica@gmail.com";
const tlf = "+34 649 29 61 96";
const githubUrl = "https://github.com/anitaSF";
const linkedinUrl = "https://linkedin.com/in/anagrafica";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>About | Anagrafica</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,100;0,200;0,300;0,400;0,700;0,800;1,300&display=swap" rel="stylesheet">
	</head>
	<body class="bg-white font-sans text-slate-950 overflow-x-hidden">
		
		<!-- HEADER / NAV -->
		<Navbar esUrl="/about" />

		<!-- HERO / SOBRE MÍ -->
		<section class="max-w-[1500px] mx-auto grid grid-cols-1 md:grid-cols-12 gap-14 sm:gap-20 items-end relative z-10">
